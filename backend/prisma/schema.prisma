// Prisma schema for Neon PostgreSQL — used for migrations & client generation.
// Complex triggers/enums are applied via db/schema.sql (npm run db:push).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppRole {
  admin
  staff
  owner

  @@map("app_role")
}

enum PetStatus {
  available
  deceased

  @@map("pet_status")
}

enum ApptType {
  scheduled
  walk_in
  request

  @@map("appt_type")
}

enum ApptStatus {
  Scheduled
  Completed
  Missed
  Cancelled
  Requested

  @@map("appt_status")
}

enum TxnType {
  in
  out

  @@map("txn_type")
}

enum ItemCategory {
  vaccine
  medication
  dewormer
  supply

  @@map("item_category")
}

model User {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                     String    @unique
  passwordHash              String?   @map("password_hash")
  firstName                 String?   @map("first_name")
  middleName                String?   @map("middle_name")
  lastName                  String?   @map("last_name")
  fullName                  String?   @map("full_name")
  googleId                  String?   @unique @map("google_id")
  profileImage              String?   @map("profile_image")
  phone                     String?
  address                   String?
  emailVerified             Boolean   @default(false) @map("email_verified")
  mustVerifyGmail           Boolean   @default(false) @map("must_verify_gmail")
  accountStatus             String    @default("Active") @map("account_status")
  failedLoginAttempts       Int       @default(0) @map("failed_login_attempts")
  accountLockedUntil        DateTime? @map("account_locked_until") @db.Timestamptz(6)
  lastLogin                 DateTime? @map("last_login") @db.Timestamptz(6)
  verificationToken         String?   @map("verification_token")
  verificationTokenExpires  DateTime? @map("verification_token_expires") @db.Timestamptz(6)
  resetPasswordToken        String?   @map("reset_password_token")
  resetPasswordTokenExpires DateTime? @map("reset_password_token_expires") @db.Timestamptz(6)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  profile      Profile?
  roles        UserRole[]
  owners       Owner[]
  loginHistory LoginHistory[]

  @@map("users")
}

model Profile {
  id        String   @id @db.Uuid
  fullName  String?  @map("full_name")
  email     String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      AppRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@map("user_roles")
}

model LoginHistory {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  loginMethod String   @map("login_method")
  loginTime   DateTime @default(now()) @map("login_time") @db.Timestamptz(6)
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("login_history")
}

model Owner {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  name      String
  contact   String?
  email     String?
  address   String?
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  pets         Pet[]
  appointments Appointment[]
  messages     Message[]
  labTransactions LabTransaction[]

  @@map("owners")
}

model Pet {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String    @map("owner_id") @db.Uuid
  name         String
  species      String?
  breed        String?
  gender       String?
  dob          DateTime? @db.Date
  imageUrl     String?   @map("image_url")
  status       PetStatus @default(available)
  causeOfDeath String?   @map("cause_of_death")
  deceasedDate DateTime? @map("deceased_date") @db.Date
  healthStatus String    @default("Healthy") @map("health_status")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  owner        Owner         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  vaccinations Vaccination[]
  dewormings   Deworming[]
  careRecords  CareRecord[]
  messages     Message[]

  @@map("pets")
}

model Appointment {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  petId     String?    @map("pet_id") @db.Uuid
  ownerId   String?    @map("owner_id") @db.Uuid
  date      DateTime   @db.Date
  time      String
  vet       String?
  reason    String?
  type      ApptType   @default(scheduled)
  status    ApptStatus @default(Scheduled)
  careType  String     @default("checkup") @map("care_type")
  notes     String?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)

  pet  Pet?   @relation(fields: [petId], references: [id], onDelete: Cascade)
  owner Owner? @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model Vaccination {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  petId         String    @map("pet_id") @db.Uuid
  appointmentId String?   @unique @map("appointment_id") @db.Uuid
  vaccineType   String    @map("vaccine_type")
  dateGiven     DateTime? @map("date_given") @db.Date
  nextDue       DateTime? @map("next_due") @db.Date
  vet           String?
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("vaccinations")
}

model Deworming {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  petId     String    @map("pet_id") @db.Uuid
  product   String
  dateGiven DateTime? @map("date_given") @db.Date
  nextDue   DateTime? @map("next_due") @db.Date
  vet       String?
  notes     String?
  status    String    @default("Scheduled")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("dewormings")
}

model CareRecord {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  petId         String    @map("pet_id") @db.Uuid
  appointmentId String?   @unique @map("appointment_id") @db.Uuid
  date          DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  vet           String?
  recordType    String    @default("checkup") @map("record_type")
  diagnosis     String?
  treatment     String?
  medication    String?
  dosage        String?
  outcome       String?
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@map("care_records")
}

model InventoryItem {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemCode       String?      @map("item_code")
  name           String
  description    String?
  brand          String?
  dosage         String?
  category       ItemCategory @default(supply)
  quantity       Int          @default(0)
  unit           String?      @default("unit")
  unitPrice      Decimal      @default(0) @map("unit_price") @db.Decimal(12, 2)
  reorderLevel   Int          @default(5) @map("reorder_level")
  expirationDate DateTime?    @map("expiration_date") @db.Date
  batchNo        String?      @map("batch_no")
  status         String?      @default("Available")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)

  batches      InventoryBatch[]
  transactions InventoryTransaction[]

  @@map("inventory_items")
}

model InventoryBatch {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventoryItemId   String    @map("inventory_item_id") @db.Uuid
  batchNo           String    @map("batch_no")
  expirationDate    DateTime? @map("expiration_date") @db.Date
  initialQuantity   Int       @default(0) @map("initial_quantity")
  remainingQuantity Int       @default(0) @map("remaining_quantity")
  receivedDate      DateTime? @default(dbgenerated("CURRENT_DATE")) @map("received_date") @db.Date
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  item         InventoryItem          @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  transactions InventoryTransaction[]

  @@unique([inventoryItemId, batchNo, expirationDate])
  @@index([inventoryItemId])
  @@index([expirationDate])
  @@index([remainingQuantity])
  @@map("inventory_batches")
}

model InventoryTransaction {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itemId           String    @map("item_id") @db.Uuid
  inventoryBatchId String?   @map("inventory_batch_id") @db.Uuid
  type             TxnType
  quantity         Int
  unitPrice        Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  totalAmount      Decimal  @default(0) @map("total_amount") @db.Decimal(12, 2)
  batchNo          String?   @map("batch_no")
  expirationDate   DateTime? @map("expiration_date") @db.Date
  reason           String?
  notes            String?
  recordedBy       String?   @map("recorded_by")
  petId            String?   @map("pet_id") @db.Uuid
  date             DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  item           InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  inventoryBatch InventoryBatch? @relation(fields: [inventoryBatchId], references: [id], onDelete: SetNull)

  @@map("inventory_transactions")
}

model LabTransaction {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  petId     String?  @map("pet_id") @db.Uuid
  ownerId   String?  @map("owner_id") @db.Uuid
  date      DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  vet       String?
  status    String   @default("Unpaid")
  total     Decimal  @default(0) @db.Decimal
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  owner Owner? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  items LabTransactionItem[]

  @@map("lab_transactions")
}

model LabTransactionItem {
  id                     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId          String  @map("transaction_id") @db.Uuid
  description            String
  quantity               Int     @default(1)
  unitPrice              Decimal @default(0) @map("unit_price") @db.Decimal(12, 2)
  lineTotal              Decimal @default(0) @map("line_total") @db.Decimal(12, 2)
  category               String?
  source                 String?
  inventoryTransactionId String? @map("inventory_transaction_id") @db.Uuid

  transaction LabTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("lab_transaction_items")
}

model Message {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String?   @map("owner_id") @db.Uuid
  petId       String?   @map("pet_id") @db.Uuid
  phone       String?
  body        String
  status      String    @default("simulated")
  channel     String    @default("sms")
  subject     String?
  email       String?
  messageType String    @default("Custom Message") @map("message_type")
  sentBy      String?   @map("sent_by")
  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz(6)
  sentAt      DateTime? @default(now()) @map("sent_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  owner Owner? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  pet   Pet?   @relation(fields: [petId], references: [id], onDelete: SetNull)

  @@map("messages")
}
