# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Auth
AUTH_SECRET=your-long-random-secret

# Server
PORT=4000
FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini AI chatbot (optional — PawBot works without this using clinic data)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=

# Email (Resend — required for verification & password-reset links to reach real inboxes)
# Without RESEND_API_KEY, emails are safely logged to the backend console.
RESEND_API_KEY=
EMAIL_FROM=

