# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Auth
AUTH_SECRET=your-long-random-secret

# Server
PORT=4000
FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini AI chatbot (optional — PawBot works without this using clinic data)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Email (required for verification & password-reset links to reach real inboxes)
# Without these, emails are only logged to the backend console.
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
GMAIL_USER=your-clinic@gmail.com
GMAIL_PASS=your-gmail-app-password
# Or use generic SMTP vars instead of GMAIL_*:
# SMTP_USER=
# SMTP_PASS=
